{
  "name": "navcove",
  "version": "1.0.0",
  "description": "NavCove - 数据库管理工具（Electron 桌面版）",
  "main": "electron/main.js",
  "author": "NavCove",
  "license": "MIT",
  "engines": {
    "node": "23.7.0"
  },
  "workspaces": [
    "web",
    "server"
  ],
  "scripts": {
    "dev:web": "cd web && npm run dev",
    "dev:server": "cd server && npm run dev",
    "dev:electron": "concurrently -k -n web,electron -c cyan,green \"npm run dev:web\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "check:node": "node -e \"const need='23.7.0'; const cur=process.versions.node; if(cur!==need){ console.error('Node 版本必须是 '+need+'（当前 '+cur+'）。请执行: nvm use'); process.exit(1); }\"",
    "predev": "npm run check:node && npm run rebuild:sqlite:node",
    "predev:server": "npm run check:node",
    "dev": "concurrently -k -n server,electron -c magenta,green \"npm run dev:server\" \"npm run dev:electron\"",
    "build:web": "cd web && npm run build",
    "rebuild:sqlite:node": "npm rebuild better-sqlite3",
    "rebuild:sqlite:electron": "electron-builder install-app-deps",
    "postinstall": "npm run rebuild:sqlite:node",
    "rebuild:native": "npm run rebuild:sqlite:electron",
    "prepack": "npm run rebuild:sqlite:electron",
    "pack": "npm run build:web && electron-builder --dir",
    "predist": "npm run rebuild:sqlite:electron",
    "dist": "npm run build:web && electron-builder",
    "dist:win": "npm run build:web && electron-builder --win nsis",
    "dist:mac": "npm run build:web && electron-builder --mac dmg zip",
    "dist:linux": "npm run build:web && electron-builder --linux AppImage deb"
  },
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/multer": "^4.0.0",
    "@koa/router": "^13.1.0",
    "better-sqlite3": "11.10.0",
    "fast-csv": "^5.0.2",
    "koa": "^2.15.3",
    "koa-bodyparser": "^4.4.1",
    "koa-compose": "^4.1.0",
    "koa-convert": "^2.0.0",
    "koa-json": "^2.0.2",
    "koa-static": "^5.0.0",
    "multer": "^2.2.0",
    "mysql2": "^3.11.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.navcove.app",
    "productName": "NavCove",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "web/dist/**/*",
      "package.json",
      "!electron/afterPack.js",
      "node_modules/koa-compose/**/*",
      "node_modules/koa-convert/**/*",
      "node_modules/better-sqlite3/build/Release/*.node",
      "!**/node_modules/better-sqlite3/prebuilds/**"
    ],
    "asar": false,
    "afterPack": "electron/afterPack.js",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "gatekeeperAssess": false,
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "${productName} ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Development"
    },
    "extraMetadata": {
      "main": "electron/main.js"
    }
  }
}
