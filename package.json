{
  "name": "navcove",
  "version": "1.0.0",
  "description": "NavCove - 数据库管理工具（Electron 桌面版）",
  "main": "electron/main.js",
  "author": "NavCove",
  "license": "MIT",
  "scripts": {
    "dev:web": "cd web && npm run dev",
    "dev:server": "cd server && npm run dev",
    "dev:electron": "concurrently -k -n web,electron -c cyan,green \"npm run dev:web\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "dev": "concurrently -k -n server,electron -c magenta,green \"npm run dev:server\" \"npm run dev:electron\"",
    "build:web": "cd web && npm run build",
    "postinstall": "electron-builder install-app-deps",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "pack": "npm run build:web && electron-builder --dir",
    "dist": "npm run build:web && electron-builder",
    "dist:win": "npm run build:web && electron-builder --win nsis portable",
    "dist:mac": "npm run build:web && electron-builder --mac dmg zip",
    "dist:linux": "npm run build:web && electron-builder --linux AppImage deb"
  },
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/multer": "^4.0.0",
    "@koa/router": "^13.1.0",
    "better-sqlite3": "^11.10.0",
    "fast-csv": "^5.0.2",
    "koa": "^2.15.3",
    "koa-bodyparser": "^4.4.1",
    "koa-compose": "^4.1.0",
    "koa-convert": "^2.0.0",
    "koa-json": "^2.0.2",
    "koa-static": "^5.0.0",
    "multer": "^2.2.0",
    "mysql2": "^3.11.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.navcove.app",
    "productName": "NavCove",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "web/dist/**/*",
      "package.json",
      "!electron/afterPack.js",
      "node_modules/koa-compose/**/*",
      "node_modules/koa-convert/**/*",
      "node_modules/better-sqlite3/build/Release/*.node",
      "!**/node_modules/better-sqlite3/prebuilds/**"
    ],
    "asar": false,
    "afterPack": "electron/afterPack.js",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "gatekeeperAssess": false,
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "${productName} ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Development"
    },
    "extraMetadata": {
      "main": "electron/main.js"
    }
  },
  "packageManager": "pnpm@10.12.4+sha512.5ea8b0deed94ed68691c9bad4c955492705c5eeb8a87ef86bc62c74a26b037b08ff9570f108b2e4dbd1dd1a9186fea925e527f141c648e85af45631074680184"
}
